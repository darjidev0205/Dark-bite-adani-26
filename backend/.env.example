# ==============================================================================
# UPI Shield - Backend Environment Configuration Template
# NOTE: Copy this file to .env and provide your actual secrets.
# NEVER commit your real .env file or Firebase service account JSON to Git.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=upi_shield

# Firebase Admin SDK Configuration
# In production, specify the project ID and either the path to serviceAccountKey.json
# or leave credentials path empty if using Google Application Default Credentials (ADC).
FIREBASE_PROJECT_ID=upi-shield-prod
FIREBASE_CREDENTIALS_PATH=

# Allowed Frontend Origins for CORS (comma-separated URLs)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Data Retention & Limits
# Number of days before scans expire via MongoDB TTL index (0 to disable auto-expiry)
SCAN_RETENTION_DAYS=90

# Rate Limiting (requests per minute per IP / authenticated user)
RATE_LIMIT_PER_MINUTE=60

# Max message character length allowed for analysis
MAX_MESSAGE_LENGTH=1000

# Security: Enable interactive Swagger UI docs (/docs & /openapi.json)
# Recommended: false in production
ENABLE_DOCS=true
